{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "键鼠助手 Mac",
  "version": "0.1.1",
  "identifier": "com.keymousehelper.macos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "键鼠助手 Mac",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "macOS 键鼠录制、自动点击与工作流回放工具",
    "longDescription": "本地运行的 macOS 键鼠录制、自动点击和工作流回放工具，支持无限循环与真人化随机偏移。",
    "copyright": "© Infinite Autoclicker contributors. MIT licensed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {}
}
